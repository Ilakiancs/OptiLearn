# Model backend — set USE_LOCAL_OLLAMA=true when going offline (recommended for classroom use)
USE_LOCAL_OLLAMA=true

# Gemini API (used only when USE_LOCAL_OLLAMA=false and internet is reachable)
GEMMA_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.0-flash

# Beyond Presence API key (used for the persona chatbot, optional but recommended for best experience)
# Only works if USE_LOCAL_OLLAMA=false and internet is reachable, otherwise the persona chatbot will fall back to a local Ollama model without access to Beyond Presence's knowledge graph and features.
BEY_API_KEY=your_beyond_presence_api_key_here

# Ollama (primary offline runtime)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_MODEL_FAST=gemma4:e2b
OLLAMA_MODEL_DEEP=gemma4:e4b

# Language detection
LANGDETECT_CONFIDENCE_THRESHOLD=0.85

# Storage
DB_PATH=./data/optilearn.db
FAISS_INDEX_PATH=./data/curriculum.index
FAISS_META_PATH=./data/curriculum_meta.json
CURRICULUM_DIR=./data/curriculum

# Embeddings
EMBED_MODEL=./models/embeddings/paraphrase-multilingual-MiniLM-L12-v2
HF_LOCAL_FILES_ONLY=true

# Image processing
IMAGE_MAX_PX=1024

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_DIST=./frontend/dist

# Online ASR fallback via Hugging Face
WHISPER_BINARY=./bin/whisper
WHISPER_MODEL=./data/whisper-models/ggml-base.bin
WHISPER_HF_MODEL=./models/whisper/openai-whisper-tiny

# Text-to-speech (TTS) — piper-tts. Set these after running the TTS setup.
PIPER_BINARY=./bin/piper
VOICES_DIR=./data/voices

# Fine-tuned student tutor model name in Ollama (future: optilearn-gemma4-e2b)
OLLAMA_TUTOR_MODEL=gemma4:e2b

# Gemma 4 26B cloud model — for live class translation when internet is fast
# Leave GEMMA_26B_API_KEY blank to disable cloud routing entirely
GEMMA_26B_API_KEY=
GEMMA_26B_BASE_URL=https://generativelanguage.googleapis.com
GEMMA_26B_MODEL=gemma-4-26b-a4b-it
# Switch to cloud when round-trip latency is below this threshold (ms)
LATENCY_THRESHOLD_MS=200

# HTTPS for student microphone access over LAN (auto-generated self-signed cert)
HTTPS_PORT=8443
SSL_CERT_PATH=./data/ssl/cert.pem
SSL_KEY_PATH=./data/ssl/key.pem

# Teacher-uploaded materials storage directory
MATERIALS_DIR=./data/materials

# Beyond Presence avatar voice chat (online only — leave blank to disable)
BEY_API_KEY=
